# Modelo do arquivo de variáveis de ambiente.
# Copio para .env e ajusto os valores:  cp .env.example .env
# O .env NÃO vai para o Git (está no .gitignore).

# Chave secreta. Gero uma nova com:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-esta-chave-por-uma-gerada

# True só na minha máquina. Em produção sempre False.
DEBUG=True

# Domínios liberados, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para POST via HTTPS (produção).
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app

# Banco. Se eu deixar comentado, o projeto usa SQLite local.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Nível de log (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
